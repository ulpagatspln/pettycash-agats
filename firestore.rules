rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya pengguna yang login yang boleh membaca dan mengubah transaksi.
    match /transactions/{id} {
      allow read, write: if request.auth != null;
    }

    // Foto kwitansi: wajib login, ukuran teks foto dibatasi sekitar 375 KB.
    match /receipts/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 500000;
    }
  }
}
